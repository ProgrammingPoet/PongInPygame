import pygame
pygame.init()#initialisation
WINDOW = pygame.display.set_mode((600,600))#window resolution
CLOCK = pygame.time.Clock()#initialising fps functionalilty

#game loop
RENDERING=True
while RENDERING==True:

    WINDOW.fill((0, 0, 0))


    

    CLOCK.tick(60)#FPS lock

    BORDER=pygame.Rect(0,0,10,600)#left border loading and drawing
    pygame.draw.rect(WINDOW, (0, 200, 0),BORDER)#left border rendering
    BORDER=pygame.Rect(590,0,10,600)#right border loading and drawing
    pygame.draw.rect(WINDOW, (0, 200, 0),BORDER)#right border rendering
    BORDER=pygame.Rect(0,0,600,10)#top border loading and drawing
    pygame.draw.rect(WINDOW, (0, 200, 0),BORDER)#top border rendering
    BORDER=pygame.Rect(0,590,600,10)#bottom border loading and drawing
    pygame.draw.rect(WINDOW, (0, 200, 0),BORDER)#bottom border rendering

    for event in pygame.event.get():#checks for inputs
        #quit from x button functionality
        if event.type == pygame.QUIT:
            RENDERING = False

    pygame.display.update()#rendering the final image

pygame.quit()
